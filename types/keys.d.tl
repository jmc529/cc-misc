   backslash: integer
   backspace: integer
   c: integer
   capsLock: integer
   comma: integer
   d: integer
   delete: integer
   down: integer
   e: integer
   eight: integer
   ["end"]: integer
   enter: integer
   equals: integer
   f: integer
   f1: integer
   f10: integer
   f11: integer
   f12: integer
   f13: integer
   f14: integer
   f15: integer
   f16: integer
   f17: integer
   f18: integer
   f19: integer
   f2: integer
   f20: integer
   f21: integer
   f22: integer
   f23: integer
   f24: integer
   f25: integer
   f3: integer
   f4: integer
   f5: integer
   f6: integer
   f7: integer
   f8: integer
   f9: integer
   five: integer
   four: integer
   g: integer
   grave: integer
   h: integer
   home: integer
   i: integer
   insert: integer
   j: integer
   k: integer
   l: integer
   left: integer
   leftAlt: integer
   leftBracket: integer
   leftCtrl: integer
   leftShift: integer
   leftSuper: integer
   m: integer
   menu: integer
   minus: integer
   n: integer
   nine: integer
   numLock: integer
   numPad0: integer
   numPad1: integer
   numPad2: integer
   numPad3: integer
   numPad4: integer
   numPad5: integer
   numPad6: integer
   numPad7: integer
   numPad8: integer
   numPad9: integer
   numPadAdd: integer
   numPadDecimal: integer
   numPadDivide: integer
   numPadEnter: integer
   numPadEqual: integer
   numPadMultiply: integer
   numPadSubtract: integer
   o: integer
   one: integer
   p: integer
   pageDown: integer
   pageUp: integer
   pause: integer
   period: integer
   printScreen: integer
   q: integer
   r: integer
   ["return"]: integer
   right: integer
   rightAlt: integer
   rightBracket: integer
   rightCtrl: integer
   rightShift: integer
   s: integer
   scrollLock: integer
   semicolon: integer
   seven: integer
   six: integer
   slash: integer
   space: integer
   t: integer
